yabai -m config layout bsp

# Slack huddle windows float instead of joining the BSP tree, so joining a
# huddle no longer reshuffles/resizes your tiled layout
yabai -m rule --add app="^Slack$" title=".*[Hh]uddle.*" manage=off

yabai -m config top_padding    10
yabai -m config bottom_padding 10
yabai -m config left_padding   10
yabai -m config right_padding  10
yabai -m config window_gap     10
